# Copier en .env et ajuster si besoin : `cp .env.example .env`.
# Le .env n'est jamais commite (voir .gitignore). Toutes ces variables ont une
# valeur par defaut dans compose.yaml : la stack demarre sans fichier .env.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# --- Kafka ---
# Port expose sur l'hote pour le listener EXTERNAL (localhost:29092).
KAFKA_PORT=29092

# --- Services ---
CART_DB_NAME=ecommerce_cart

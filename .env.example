# Copier en .env et ajuster si besoin : `cp .env.example .env`.
# Le .env n'est jamais commite (voir .gitignore). Toutes ces variables ont une
# valeur par defaut dans compose.yaml : la stack demarre sans fichier .env.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
# URL par laquelle navigateurs ET services joignent Keycloak. Elle devient
# l'issuer des jetons : si les deux cotes ne voient pas la meme valeur, la
# validation du JWT echoue.
KEYCLOAK_FRONTEND_URL=http://localhost:8180

# --- Fournisseurs d'identite (T03) ---
# Laisses vides, les deux fournisseurs sont importes desactives. Renseigner un
# couple puis activer le fournisseur dans la console Keycloak pour l'essayer.
# Ne jamais commiter de vraies valeurs : ce sont des secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : clientId = le « Services ID », clientSecret = un JWT signe avec la
# cle .p8, valable 6 mois au maximum et donc a regenerer. Voir le README.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Kafka ---
# Port expose sur l'hote pour le listener EXTERNAL (localhost:29092).
KAFKA_PORT=29092

# --- Services ---
CART_DB_NAME=ecommerce_cart
